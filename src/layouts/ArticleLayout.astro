---
import Layout from './Layout.astro';

export interface Props {
  title: string;
  titleEn?: string;
  type: string;
  date: string;
  tags?: string[];
  description?: string;
  venue?: string;
}
const { title, titleEn, type, date, tags = [], description, venue } = Astro.props;
---

<Layout title={title} description={description}>
  <style>
    .article-back {
      padding: 2rem 2.5rem 0;
    }

    .back-link {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      transition: color 0.2s;
    }

    .back-link:hover {
      color: var(--accent);
    }

    .article-header {
      padding: 2.5rem 2.5rem 3rem;
      border-bottom: 1px solid var(--border);
      max-width: 780px;
    }

    .article-meta-row {
      display: flex;
      gap: 1.5rem;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .article-type {
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      font-family: 'DM Mono', monospace;
    }

    .article-date {
      font-size: 0.65rem;
      color: var(--muted);
      font-family: 'DM Mono', monospace;
    }

    .article-venue {
      font-size: 0.65rem;
      color: var(--muted);
      font-family: 'DM Mono', monospace;
      padding-left: 1.5rem;
      border-left: 1px solid var(--border);
    }

    .article-title {
      font-family: 'DM Serif Display', serif;
      font-size: clamp(2rem, 4vw, 3.2rem);
      line-height: 1.1;
      margin-bottom: 0.5rem;
    }

    .article-title-en {
      font-size: 0.78rem;
      color: var(--muted);
      font-family: 'DM Mono', monospace;
      margin-bottom: 1.5rem;
      letter-spacing: 0.04em;
    }

    .article-desc {
      font-size: 0.88rem;
      line-height: 1.8;
      color: var(--muted);
      font-family: 'Noto Serif KR', serif;
      margin-bottom: 1.5rem;
      max-width: 600px;
    }

    .article-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .article-body {
      padding: 4rem 2.5rem;
      max-width: 780px;
      font-family: 'Noto Serif KR', serif;
      font-size: 0.9rem;
      line-height: 1.9;
      color: var(--text);
    }

    .article-body p {
      margin-bottom: 1.5rem;
    }

    .article-body h2 {
      font-family: 'DM Serif Display', serif;
      font-size: 1.5rem;
      margin: 3rem 0 1rem;
      color: var(--text);
    }

    .article-body h3 {
      font-family: 'DM Mono', monospace;
      font-size: 0.8rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 2rem 0 0.75rem;
    }

    .article-body blockquote {
      border-left: 2px solid var(--accent);
      padding-left: 1.5rem;
      margin: 2rem 0;
      color: var(--muted);
      font-style: italic;
    }

    .divider {
      border: none;
      border-top: 1px solid var(--border);
      margin: 3rem 0;
    }

    @media (max-width: 768px) {
      .article-header,
      .article-body {
        padding-left: 1.5rem;
        padding-right: 1.5rem;
      }
      .article-back {
        padding-left: 1.5rem;
      }
    }
  </style>

  <div class="article-back">
    <a href="/writing" class="back-link">← Writing & Ideas</a>
  </div>

  <header class="article-header">
    <div class="article-meta-row">
      <span class="article-type">{type}</span>
      <span class="article-date">{date}</span>
      {venue && <span class="article-venue">{venue}</span>}
    </div>
    <h1 class="article-title">{title}</h1>
    {titleEn && <p class="article-title-en">{titleEn}</p>}
    {description && <p class="article-desc">{description}</p>}
    <div class="article-tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </header>

  <div class="article-body">
    <slot />
  </div>
</Layout>
