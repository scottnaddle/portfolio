---
import Layout from '../layouts/Layout.astro';

const featuredItems = [
  {
    type: 'Writing',
    typeKo: '글',
    title: '연결된 배움',
    subtitle: '기술이 교육을 다시 쓴 150년의 이야기',
    desc: '교육 기술의 역사를 통해 AI 시대의 학습을 재정의하는 12챕터 시리즈.',
    href: '/writing',
    accent: true,
  },
  {
    type: 'Project',
    typeKo: '프로젝트',
    title: 'UBION AI Newsroom',
    subtitle: 'insight.ubion.global',
    desc: 'Ghost CMS 기반 9-에이전트 뉴스룸 파이프라인. ODA 입찰 정보 자동 수집·발행.',
    href: 'https://insight.ubion.global',
    accent: false,
  },
  {
    type: 'Project',
    typeKo: '프로젝트',
    title: 'OpenClaw Multi-Agent System',
    subtitle: 'AI Democratization for EdTech',
    desc: '비개발자를 위한 노코드 AI 에이전트 오케스트레이션. UBION AI 전환 센터.',
    href: '/projects',
    accent: false,
  },
];
---

<Layout title="Home">
  <style>
    /* HERO */
    .hero {
      min-height: 90vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      position: relative;
      overflow: hidden;
    }

    .hero-left {
      padding: 6rem 2.5rem 4rem;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      border-right: 1px solid var(--border);
    }

    .hero-eyebrow {
      font-size: 0.68rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.5rem;
    }

    .hero-title {
      font-family: 'DM Serif Display', serif;
      font-size: clamp(2.8rem, 5vw, 5rem);
      line-height: 1.05;
      color: var(--text);
      margin-bottom: 1rem;
    }

    .hero-title em {
      font-style: italic;
      color: var(--accent);
    }

    .hero-sub {
      font-family: 'Noto Serif KR', serif;
      font-size: 1rem;
      color: var(--muted);
      line-height: 1.8;
      max-width: 400px;
      margin-top: 1rem;
    }

    .hero-cta {
      margin-top: 3rem;
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .btn-primary {
      padding: 0.75rem 1.75rem;
      background: var(--accent);
      color: var(--bg);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 500;
      transition: opacity 0.2s;
    }

    .btn-primary:hover { opacity: 0.85; }

    .btn-ghost {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      border-bottom: 1px solid var(--border);
      padding-bottom: 2px;
      transition: color 0.2s, border-color 0.2s;
    }

    .btn-ghost:hover {
      color: var(--text);
      border-color: var(--text);
    }

    .hero-right {
      padding: 6rem 2.5rem 4rem;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 0;
      position: relative;
    }

    .hero-stat-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: var(--border);
      margin-bottom: 3rem;
    }

    .hero-stat {
      background: var(--bg);
      padding: 1.5rem;
    }

    .hero-stat-num {
      font-family: 'DM Serif Display', serif;
      font-size: 2rem;
      color: var(--accent);
      line-height: 1;
      margin-bottom: 0.4rem;
    }

    .hero-stat-label {
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .hero-desc {
      font-size: 0.78rem;
      line-height: 1.9;
      color: var(--muted);
      border-left: 2px solid var(--accent-dim);
      padding-left: 1rem;
    }

    /* BG DECORATION */
    .bg-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(var(--border) 1px, transparent 1px),
        linear-gradient(90deg, var(--border) 1px, transparent 1px);
      background-size: 60px 60px;
      opacity: 0.25;
      pointer-events: none;
      z-index: -1;
    }

    /* FEATURED */
    .section {
      padding: 5rem 2.5rem;
      border-top: 1px solid var(--border);
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 3rem;
    }

    .section-title {
      font-family: 'DM Serif Display', serif;
      font-size: 1.6rem;
      color: var(--text);
    }

    .section-link {
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
      border-bottom: 1px solid var(--border);
      transition: color 0.2s;
    }

    .section-link:hover { color: var(--accent); }

    .featured-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 1px;
      background: var(--border);
    }

    .featured-card {
      background: var(--bg);
      padding: 2rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      transition: background 0.2s;
      cursor: pointer;
    }

    .featured-card:hover {
      background: var(--surface);
    }

    .featured-card.large {
      padding: 2.5rem;
    }

    .card-type {
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .card-title {
      font-family: 'DM Serif Display', serif;
      font-size: 1.3rem;
      line-height: 1.2;
      color: var(--text);
    }

    .featured-card.large .card-title {
      font-size: 1.8rem;
    }

    .card-subtitle {
      font-size: 0.72rem;
      color: var(--accent-dim);
      font-family: 'DM Mono', monospace;
    }

    .card-desc {
      font-size: 0.8rem;
      line-height: 1.75;
      color: var(--muted);
      margin-top: 0.5rem;
      font-family: 'Noto Serif KR', serif;
    }

    .card-arrow {
      margin-top: auto;
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      transition: color 0.2s;
    }

    .featured-card:hover .card-arrow {
      color: var(--accent);
    }

    /* TICKER */
    .ticker {
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 0.75rem 0;
      overflow: hidden;
      white-space: nowrap;
    }

    .ticker-inner {
      display: inline-block;
      animation: ticker 20s linear infinite;
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .ticker-inner span {
      margin: 0 2rem;
    }

    .ticker-inner span.dot {
      color: var(--accent);
      margin: 0 0.5rem;
    }

    @keyframes ticker {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    @media (max-width: 768px) {
      .hero { grid-template-columns: 1fr; }
      .hero-right { border-top: 1px solid var(--border); }
      .featured-grid { grid-template-columns: 1fr; }
      nav { padding: 1rem 1.25rem; }
      .nav-links { gap: 1rem; }
    }
  </style>

  <div class="bg-grid"></div>

  <section class="hero">
    <div class="hero-left">
      <p class="hero-eyebrow">VP, UBION · AI Transformation · ODA EdTech</p>
      <h1 class="hero-title">
        Building the<br />
        <em>Future</em> of<br />
        Learning
      </h1>
      <p class="hero-sub">
        교육 기술 20년 경력. AI 에이전트, ODA 프로젝트,<br/>
        그리고 학습의 미래를 기록합니다.
      </p>
      <div class="hero-cta">
        <a href="/about" class="btn-primary">About Me</a>
        <a href="/projects" class="btn-ghost">프로젝트 보기 →</a>
      </div>
    </div>

    <div class="hero-right">
      <div class="hero-stat-grid">
        <div class="hero-stat">
          <div class="hero-stat-num">20+</div>
          <div class="hero-stat-label">Years in EdTech</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">7</div>
          <div class="hero-stat-label">Countries · ODA</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">12</div>
          <div class="hero-stat-label">Book Chapters</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">9</div>
          <div class="hero-stat-label">AI Agents Built</div>
        </div>
      </div>
      <p class="hero-desc">
        Kazakhstan · Vietnam · Cambodia · Sri Lanka · Uzbekistan.<br/>
        KOICA · ADB · UNESCO 프로젝트 리드.<br/>
        AI 전환 센터 구축 중.
      </p>
    </div>
  </section>

  <div class="ticker">
    <div class="ticker-inner">
      <span>EdTech</span><span class="dot">◆</span>
      <span>ODA Projects</span><span class="dot">◆</span>
      <span>AI Agents</span><span class="dot">◆</span>
      <span>Ghost CMS</span><span class="dot">◆</span>
      <span>연결된 배움</span><span class="dot">◆</span>
      <span>KOICA · ADB · UNESCO</span><span class="dot">◆</span>
      <span>LMS · LXP · TVET</span><span class="dot">◆</span>
      <span>OpenClaw · Claude</span><span class="dot">◆</span>
      <span>EdTech</span><span class="dot">◆</span>
      <span>ODA Projects</span><span class="dot">◆</span>
      <span>AI Agents</span><span class="dot">◆</span>
      <span>Ghost CMS</span><span class="dot">◆</span>
      <span>연결된 배움</span><span class="dot">◆</span>
      <span>KOICA · ADB · UNESCO</span><span class="dot">◆</span>
      <span>LMS · LXP · TVET</span><span class="dot">◆</span>
      <span>OpenClaw · Claude</span><span class="dot">◆</span>
    </div>
  </div>

  <section class="section">
    <div class="section-header">
      <h2 class="section-title">Featured Work</h2>
      <a href="/projects" class="section-link">All Projects →</a>
    </div>

    <div class="featured-grid">
      {featuredItems.map((item, i) => (
        <a href={item.href} class={`featured-card ${i === 0 ? 'large' : ''}`}>
          <span class="card-type">{item.type} · {item.typeKo}</span>
          <h3 class="card-title">{item.title}</h3>
          <span class="card-subtitle">{item.subtitle}</span>
          <p class="card-desc">{item.desc}</p>
          <span class="card-arrow">
            <span>View</span>
            <span>→</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>
